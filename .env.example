# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Evermore"

# --- Database (Neon Postgres) ---
# Create a project at https://neon.tech and paste the pooled connection string.
DATABASE_URL=postgresql://makindu:adminadmin@localhost/tex

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:3003
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3003

# --- Seed users (pnpm db:seed-users) ---
# Bootstrap: runs on deploy when no admin/super_admin exists. Required in production.
# SEED_ADMIN_EMAIL=admin@yourdomain.com
# SEED_ADMIN_PASSWORD=use-a-strong-secret-here
# SEED_ADMIN_NAME=Evermore Admin
# Dev-only personas (skipped when NODE_ENV=production):
# SEED_DEV_PASSWORD=ChangeMeDev123!
# SEED_DEV_EXPLORER_EMAIL=explorer@evermore.local
# SEED_DEV_ELITE_EMAIL=elite@evermore.local
# SEED_DEV_COUPLE_EMAIL=couple@evermore.local

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Payments: TinyPesa (M-Pesa, KES) ---
# Sign up at https://developers.tinypesa.com/
TINYPESA_API_KEY=
TINYPESA_ACCOUNT_NO=
TINYPESA_BASE_URL=https://tinypesa.com/api/v1
# Shared secret appended to the callback URL (?secret=...) for webhook auth
TINYPESA_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM="Evermore <hello@evermore.co.ke>"

# --- SMS (Africa's Talking) ---
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# --- Storage (Cloudflare R2 — S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=evermore-media
R2_PUBLIC_BASE_URL=

# --- Inngest ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- QR / ticket signing (falls back to BETTER_AUTH_SECRET if unset) ---
QR_TOKEN_SECRET=
